{
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "legacy",
      "public": "legacy",
      "redirects": [
        { "source": "/:path*", "destination": "https://safecom-malawi.web.app/:path", "type": 301 }
      ]
    }
  ]
}
